# ============================================
# BarGAIN — Variables de Entorno
# Copiar a .env y configurar valores reales
# ============================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=CHANGE-ME-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostgreSQL + PostGIS)
# Usar localhost para desarrollo local sin Docker; en Docker se sobreescribe automáticamente
DATABASE_URL=postgis://bargain_user:bargain_password@localhost:5432/bargain_db
OSGEO4W_ROOT=C:\OSGeo4W
GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal312.dll
GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll

# Credenciales de PostgreSQL (usadas por docker-compose.yml de producción)
POSTGRES_USER=bargain_user
POSTGRES_PASSWORD=bargain_password
POSTGRES_DB=bargain_db

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,exp://localhost:8081

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Frontend Expo (web/native): clave pública y Map ID para Advanced Markers
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id
# Portal Business (frontend/web, Vite): clave del navegador (Maps JS + Places)
# para el autocompletado de direcciones. Restríngela por dominio en Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OSRM (alternativa OSS a Google Directions)
OSRM_BASE_URL=https://router.project-osrm.org

# OpenRouteService (matriz de distancias para el optimizador en staging)
# Obtener en: openrouteservice.org -> Dashboard -> API Keys -> Create API Key (plan gratuito)
ORS_API_KEY=your-ors-api-key

# Gemini (Asistente LLM)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PRODUCT_MATCH_MODEL=gemini-3-flash-preview

# OCR (Google Cloud Vision API)
GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key

# Email (notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@bargain.app

# Sentry (monitorización de errores)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Logging estructurado
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# Scraping
SCRAPING_USER_AGENT=BarGAIN-Bot/1.0 (+https://github.com/Nicoparri/bargain-tfg)
SCRAPING_CONCURRENT_REQUESTS=4
SCRAPING_DOWNLOAD_DELAY=2
